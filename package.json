{
  "name": "story-writer",
  "version": "0.1.0",
  "description": "A story-writer agent that consults character agents when it needs to know how someone would behave.",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "preflight": "npx tsx story-writer.ts --preflight",
    "audit": "npx tsx scripts/story-audit.ts",
    "revision-benchmark": "npx tsx scripts/revision-benchmark.ts",
    "judge-diagnostic": "npx tsx scripts/judge-diagnostic.ts",
    "done-judge-bench": "npx tsx scripts/done-judge-bench.ts",
    "smooth-prototype": "npx tsx scripts/smooth-prototype.ts",
    "census": "npx tsx scripts/action-census.ts",
    "typecheck": "npx tsc",
    "lint": "eslint .",
    "test:gui": "playwright test",
    "check": "node scripts/check.mjs",
    "capture": "playwright test -c docs/mockups/capture/capture.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "vscode-languageclient": "^10.1.1",
    "zod": "^4.4.3"
  }
}
